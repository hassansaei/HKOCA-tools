
manifest {
    name            = 'HKOCA-tools-nextflow'
    author          = 'HKOCA / NephAtlas'
    homePage        = 'https://github.com/haythem03/HKOCA-tools'
    description     = 'Nextflow wrapper for HKOCA-tools modules'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

params {
    help = false

    // Required inputs
    sample_info = null
    gtf         = null
    outdir      = null
    working_dir = "${projectDir}"

    // Stage toggles (mirror hkoca pipeline)
    skip_cellbender = false
    run_projection  = false
    force           = false

    // Projection references (external; not produced by this workflow)
    atlas     = null
    model_dir = null

    // Publish
    publish_mode       = 'copy'
    publish_cellbender = true

    // Conda env specs (YAML files shipped in conda/). Override with absolute
    // prefixes of pre-built envs if you already created them once.
    conda_cellbender   = "${projectDir}/conda/environment_cellbender.yaml"
    conda_harmonize    = "${projectDir}/conda/environment_harmonize.yaml"
    conda_qc           = "${projectDir}/conda/environment_qc.yaml"
    conda_integration  = "${projectDir}/conda/environment_integration.yaml"
    conda_projection   = "${projectDir}/conda/environment_projection.yaml"
    qc_env_name        = 'sc_qc_pipeline'
    projection_env_name = 'hkoca_projection'

    // CellBender (packaged defaults from cellbender.config)
    cellbender_mode            = 'h5'
    cellbender_config          = null
    cellbender_h5_filename     = 'raw_feature_bc_matrix.h5'
    cellbender_mtx_dirname     = 'raw_feature_bc_matrix'
    cellbender_output_suffix   = '_filtered.h5'
    cellbender_epochs          = 100
    cellbender_total_droplets  = 35000
    cellbender_learning_rate   = 0.00005
    cellbender_cuda            = true

    // Harmonize
    harmonize_config = null
    transgenes       = 'AAV,EGFP,mCherry,GFP,eGFP,LK03-eGFP'

    // QC
    qc_config      = null
    qc_run         = 'all'
    qc_rds_pattern = '_harmonized\\.rds$'

    // Annotation
    annotation_markers     = null  // default: packaged snapseed_markers_v4.yaml
    annotation_config      = null
    annotation_resolutions = null  // default: 0.4,0.6,1.0
    annotation_save_plots  = true

    // Integration
    integration_config  = null
    integration_methods = 'harmony,rpca,cca'
    r_max_vsize         = '150Gb'

    // Projection
    projection_config    = null
    projection_joint_umap = false

    work_dir_default = "${projectDir}/work"
}

workDir = params.work_dir_default ?: "${projectDir}/work"

process {
    cpus   = 2
    memory = '16 GB'
    time   = '12.h'

    withLabel: process_single {
        cpus   = 1
        memory = '2 GB'
        time   = '1.h'
    }
    withLabel: process_medium {
        cpus   = 4
        memory = '32 GB'
        time   = '24.h'
    }
    withLabel: process_high {
        cpus   = 8
        memory = '64 GB'
        time   = '48.h'
    }
    withLabel: process_long {
        time = '72.h'
    }
    withLabel: gpu {
        cpus   = 4
        memory = '64 GB'
    }
    withLabel: gpu_optional {
        cpus   = 8
        memory = '64 GB'
    }
}

profiles {
    standard {
        // Local executor; use only on an allocated compute node.
    }

    conda {
        conda.enabled  = true
        conda.useMamba = false
        conda.cacheDir = "${projectDir}/.nextflow_conda"
        conda.createTimeout = '3 h'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        singularity.cacheDir   = "${projectDir}/.singularity"
    }

    slurm {
        process.executor = 'slurm'
        process.queue    = 'normal'
        executor {
            queueSize = 50
        }
        process {
            withLabel: process_high {
                cpus   = 16
                memory = '128 GB'
            }
            withLabel: process_medium {
                cpus   = 8
                memory = '64 GB'
            }
        }
    }

    gpu {
        process {
            withLabel: gpu {
                clusterOptions = '--gres=gpu:1'
                containerOptions = '--nv'
            }
            withLabel: gpu_optional {
                clusterOptions = '--gres=gpu:1'
            }
        }
    }

    test {
        params.skip_cellbender = true
        params.run_projection  = false
        params.force           = false
        process {
            cpus   = 2
            memory = '8 GB'
            time   = '2.h'
        }
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: 'results'}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: 'results'}/pipeline_info/report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: 'results'}/pipeline_info/trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir ?: 'results'}/pipeline_info/dag.html"
}

workflow.onComplete = {
    def out = params.outdir ?: '(no --outdir)'
    println "HKOCA Nextflow run finished: ${workflow.success ? 'SUCCESS' : 'FAILED'}"
    println "Results: ${out}"
    println "Duration: ${workflow.duration}"
}

workflow.onError = {
    println "HKOCA Nextflow ERROR: ${workflow.errorMessage ?: 'unknown'}"
}
