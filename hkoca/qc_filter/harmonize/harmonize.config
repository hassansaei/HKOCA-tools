# Gene-space harmonization defaults for HKOCA (qc-filter stage).
# Used by: hkoca qc-filter
# CLI flags override matching values in this file.
# Precedence: CLI > this config > environment variables.

[paths]
working_dir = ./
# Absolute path, or path relative to working_dir
gtf_file =
metadata_csv =
output_root =

[transgenes]
# Comma-separated reporter / transgene names to keep even if absent from the GTF
names = AAV,EGFP,mCherry,GFP,eGFP,LK03-eGFP

[summary]
figure_dpi = 300
figure_extensions = png, pdf
report_subdir = reports/atlas_summary
age_plot_top_n = 15
