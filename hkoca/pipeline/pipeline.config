# HKOCA end-to-end pipeline configuration.
# Precedence: CLI flags > this file > defaults.
# Used by: hkoca pipeline

[paths]
working_dir = ./
sample_info_csv =
gtf_file =
output_root =

[stages]
# Set run_cellbender = false to skip ambient RNA removal for all samples.
run_cellbender = true
cellbender_mode = h5
from_stage = cellbender
to_stage = integration
# Opt-in GPU atlas mapping (requires hkoca_projection env + atlas/model paths).
run_projection = false

[cellbender]
# Optional override; default is package cellbender.config
config =

[harmonize]
config =
transgenes = AAV,EGFP,mCherry,GFP,eGFP,LK03_eGFP

[qc]
config =
output_subdir = qc_filter
run = all

[annotation]
output_subdir = annotation
# Optional overrides; defaults use packaged annotation config and snapseed markers
config =
markers =

[integration]
output_subdir = integration
methods = harmony,rpca,cca
# Optional override; default is packaged integration.config.dcf
config =

[projection]
atlas_h5ad =
model_dir =
output_subdir = projection
config =
