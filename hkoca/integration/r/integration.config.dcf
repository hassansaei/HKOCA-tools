# Default integration prep config (SCT + resolution selection).
# CLI flags override these values.

# R vector heap limit (integration can exceed default memory).
r_max_vsize: 150Gb

# Input paths (override with --input_rds / --annotated_h5ad).
input_rds: null
annotated_h5ad: null

# Output base directory (override with --output_dir).
# Layout:
#   prep/              SCT object + elbow/clustree/silhouette PNGs
#                      integration_split_prepared.rds (split SCT+PCA for methods)
#   nonintegrated/     pre-integration UMAP + FeaturePlots
#   harmony/ rpca/ cca/ per-method figures
#   objects/           integrated_*.rds
#   tables/            silhouette + summary CSVs
#   integration_prep.log / integration_methods.log at output root
output_dir: integration_results

# SCT / PCA parameters
n_features: 2500
npcs: 50
neighbor_dims: 1:30
mito_regress: percent.mito

# Clustering resolutions for clustree + silhouette
resolutions: 0.3,0.4,0.5,0.6,0.8,1.0,1.2
cluster_prefix: SCT_snn_res.

# Silhouette subsample size (full dataset if smaller)
silhouette_subsample: 5000
silhouette_seed: 42
# Ignore very coarse resolutions when picking the silhouette maximum
silhouette_min_resolution: 0.4
silhouette_min_clusters: 5

# Skip when prep outputs already exist
skip_existing: TRUE

# Delete heavy intermediate files after a successful stage
remove_intermediate: FALSE

# Shared HKOCA cell-type colors (same as annotation module)
celltype_colors_yaml: null

# Marker YAML for FeaturePlots and re-annotation (default: packaged snapseed_markers_v4.yaml)
markers_yaml: null

# Integration methods to run (comma-separated; default: harmony,rpca,cca)
methods: harmony,rpca,cca

# Dims used for FindNeighbors + RunUMAP in all integration methods
integration_dims: 1:30

# Metadata column used to split layers for IntegrateLayers (needs >= 2 levels)
integration_batch_key: sample_id

# Per-method clustering resolutions (override individually as needed)
harmony_resolution: 0.6
rpca_resolution: 0.5
cca_resolution: 0.5
