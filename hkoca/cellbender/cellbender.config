# CellBender ambient RNA removal defaults for HKOCA.
# Used by: hkoca cellbender h5|mtx
# CLI flags override matching values in this file.

[paths]
# Working directory used to resolve relative sample paths.
working_dir = ./

# Parent directory that contains one subdirectory per sample.
# Leave empty if [paths] samples lists absolute paths.
samples_dir =

# Comma-separated sample IDs (subdirectory names) or absolute sample paths.
# Example: sampleA,sampleB,sampleC
samples =

[input]
# H5 mode: file name under each sample directory
h5_filename = raw_feature_bc_matrix.h5

# MTX mode: directory under each sample that contains the CellRanger MTX triplet
# (matrix.mtx[.gz], features/genes.tsv[.gz], barcodes.tsv[.gz])
mtx_dirname = raw_feature_bc_matrix

# Output file written into each sample directory: {sample_id}{output_suffix}
output_suffix = _filtered.h5

[cellbender]
mode = full
cuda = true
epochs = 100
posterior_batch_size = 64
total_droplets_included = 35000
learning_rate = 0.00005
cpu_threads = 24
