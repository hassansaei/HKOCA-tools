# HKOCA QC & Doublet Detection Pipeline - Configuration File
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Global Paths ──────────────────────────────────────────────────────────────
# Directory containing input .rds files to process
rds_dir: /data-master/pure-workspace/labss/hmami/new_data/rds_files

# Base directory where results (Summary, Filtered RDS, Logs) will be saved
output_dir: /data-master/pure-workspace/labss/hmami/new_data/HKOCA-tools/scripts/test/qc/final/qc_results_30_03

# Format:
#   header line (must include Dataset_Name)
#   one row per dataset on the following indented lines
qc_decisions_table: Dataset_Name,Lower_Feature_Method,Lower_Count_Method,Upper_Feature_Method,Upper_Count_Method,Upper_Mito_Method
control_G7_cellbender_feature_bc_matrix_filtered.rds,manual_3000,manual_8000,mad3,manual_160000,manual_15
control_TTC21B_cellbender_feature_bc_matrix_filtered.rds,manual_3000,manual_8000,mad3,manual_160000,manual_15
