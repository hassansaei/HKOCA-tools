# =============================================================================
# Config for data_loader_harmonized_21datasets.py
# 21 atlas datasets (scRNA-seq) + LMRH concat (G7 / TTC21B DMSO)
# =============================================================================

[paths]
# Root that contains per-study raw folders
data_root = /data-master/pure-workspace/labss/hmami/new_data/data

# Parent for harmonised / intermediate outputs
output_root = /data-master/pure-workspace/labss/hmami/new_data/Updated_data

# Subdirectories under output_root
harmonized_subdir = updated_harmonized_files
h5ad_subdir = updated_h5ad_files

# Ensembl GTF used to build the reference gene panel
gtf_file = /data-master/pure-workspace/labss/hmami/new_data/meta/gtf/Homo_sapiens.GRCh38.104.gtf

[reference]
# Gene biotypes retained from the GTF (comma-separated)
gene_biotypes = protein_coding,lncRNA

[metadata]
# Columns required on every cell; missing ones are filled
standard_cols = sample_id,study,source,diff_protocol,sc_protocol,sequencing,genome_build,Age,type,disease,condition
fill_value = unknown

# Defaults applied when a loader does not set a field explicitly
default_type = scRNAseq
default_genome_build = hg38
default_disease = Control

[io]
# If true, refuse to overwrite existing raw/harmonised/freeze h5ad files
refuse_overwrite = true

[studies]
# Comma-separated study keys to run (order is respected).
# Use "all" to run the full atlas list below.
enabled = all

# Canonical atlas study keys (21).  stem_2021_12_010 removed.
list =
    d10_1016_j_cell_2020_04_004,
    d10_1016_j_celrep_2020_108514,
    d10_1016_j_cmet_2022_04_009,
    d10_1016_j_devcel_2019_06_001,
    d10_1016_j_stem_2018_04_022,
    d10_1016_j_stem_2018_10_010,
    d10_1016_j_stem_2019_06_009,
    d10_1016_j_stem_2021_11_001,
    d10_1016_j_stem_2022_06_005,
    d10_1038_s41467_019_13382_0,
    d10_1038_s41467_022_33623_z,
    d10_1038_s41551_025_01542_1,
    d10_1038_s41563_020_00853_9,
    d10_1038_s41592_018_0253_2,
    d10_1038_s42003_024_07069_6,
    d10_1101_505396,
    d10_1126_sciadv_abj5633,
    d10_1172_jci_insight_122697,
    d10_1242_dev_200198,
    dno_doi_kidney_organoid_GSE312980,
    dno_doi_kidney_organoid_LMRH

[lmrh]
study_id = dno_doi_kidney_organoid_LMRH
input_subdir = LMRH_H5AD
source = hiPSC
diff_protocol = Morizane_modified
sc_protocol = 10x_3_v3.1
sequencing = Illumina_NovaSeq_6000
only_harmonized_suffix = _only_harmonized.h5ad
freeze_harmonized_suffix = _harmonized.h5ad
include_clone_controls = true

[clone_g7]
study_id = clone_controle_G7_DMSO
sample_id = G7_DMSO
mtx_subdir = filtered_feature_bc_matrix
source = hiPSC
diff_protocol = Morizane
sc_protocol = 10x_3_v4
sequencing = Illumina_HiSeq_2500
Age = d38
condition = DMSO

[clone_ttc21b]
study_id = clone_controle_TTC21B_DMSO
sample_id = TTC21B_DMSO
mtx_subdir = filtered_feature_bc_matrix
source = hiPSC
diff_protocol = Morizane
sc_protocol = 10x_3_v4
sequencing = Illumina_HiSeq_2500
Age = d38
condition = DMSO
