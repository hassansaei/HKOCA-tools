Bootstrap: docker
From: nvidia/cuda:12.1.0-cudnn8-runtime-ubuntu22.04

%labels
    Author          Haythem Mami
    Version         0.3.2-cu121
    Description     CellBender 0.3.2 + PyTorch 2.1.2 cu121 (A100 + H100)
    CUDA_Version    12.1
    Python_Version  3.10
    Torch_Version   2.1.2+cu121

%help
    CellBender 0.3.2 with PyTorch 2.1.2+cu121 (A100 and H100).

    Build from conda/ (compute node):
        cd conda
        apptainer build cellbender_v0.3.2_cu121.sif cellbender_v0.3.2_updated.def

    GPU check:
        apptainer exec --nv cellbender_v0.3.2_cu121.sif \
            python -c "import torch; print(torch.__version__, torch.cuda.get_device_name(0))"

%environment
    export PATH=/opt/miniforge/envs/cellbender/bin:/opt/miniforge/bin:$PATH
    export CONDA_DEFAULT_ENV=cellbender
    export CONDA_PREFIX=/opt/miniforge/envs/cellbender
    export LD_LIBRARY_PATH=/opt/miniforge/envs/cellbender/lib:/opt/miniforge/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
    export TORCH_HOME=/tmp/torch_cache
    export XDG_CACHE_HOME=/tmp/xdg_cache
    export MPLCONFIGDIR=/tmp/matplotlib
    export NUMBA_CACHE_DIR=/tmp/numba_cache
    export PYTHONDONTWRITEBYTECODE=1

%files
    patches/checkpoint.py /tmp/checkpoint_patched.py
    patches/report.py /tmp/report_patched.py

%post
    set -eu

    mkdir -p /opt/tmp /opt/pip_tmp /opt/conda_pkgs
    export TMPDIR=/opt/tmp
    export TEMP=/opt/tmp
    export TMP=/opt/tmp
    export PIP_CACHE_DIR=/opt/pip_tmp
    export PYTHONPYCACHEPREFIX=/opt/tmp/pycache
    export CONDA_PKGS_DIRS=/opt/conda_pkgs
    export XDG_CACHE_HOME=/opt/tmp/xdg
    export MPLCONFIGDIR=/opt/tmp/matplotlib
    mkdir -p /opt/tmp/xdg /opt/tmp/matplotlib /opt/tmp/pycache

    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y --no-install-recommends \
        wget \
        bzip2 \
        ca-certificates \
        curl \
        git \
        libhdf5-dev \
        pkg-config
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    wget -q \
        https://github.com/conda-forge/miniforge/releases/latest/download/Miniforge3-Linux-x86_64.sh \
        -O /opt/tmp/miniforge.sh
    bash /opt/tmp/miniforge.sh -b -p /opt/miniforge
    rm /opt/tmp/miniforge.sh

    export PATH=/opt/miniforge/bin:$PATH
    conda config --system --set auto_activate_base false

    conda create -y -n cellbender python=3.10
    . /opt/miniforge/etc/profile.d/conda.sh
    conda activate cellbender

    conda install -y -n cellbender -c conda-forge libstdcxx-ng

    pip install --no-cache-dir \
        torch==2.1.2 \
        --index-url https://download.pytorch.org/whl/cu121

    pip install --no-cache-dir \
        "numpy<2" \
        dill \
        cellbender==0.3.2

    CB=/opt/miniforge/envs/cellbender/lib/python3.10/site-packages/cellbender/remove_background
    cp /tmp/checkpoint_patched.py "${CB}/checkpoint.py"
    cp /tmp/report_patched.py "${CB}/report.py"

    conda clean --all --force-pkgs-dirs -y
    pip cache purge || true
    find /opt/miniforge -name "*.pyc" -delete 2>/dev/null || true
    find /opt/miniforge -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
    rm -rf /opt/tmp /opt/pip_tmp /opt/conda_pkgs

%runscript
    exec /opt/miniforge/envs/cellbender/bin/cellbender "$@"

%test
    . /opt/miniforge/etc/profile.d/conda.sh
    conda activate cellbender
    /opt/miniforge/envs/cellbender/bin/python -c "
import cellbender, torch, numpy
print('CellBender:', cellbender.__version__)
print('PyTorch:   ', torch.__version__)
print('NumPy:     ', numpy.__version__)
print('CUDA built:', torch.version.cuda)
print('CUDA avail (needs GPU node):', torch.cuda.is_available())
print('==> build test OK')
"
